# Curated clang-tidy config for fms-m. CLion reads this automatically and runs
# ONLY these checks, so the IDE surfaces the cleanups we've actually applied
# rather than the full firehose (Boost macro noise, magic numbers, design-level
# member-visibility rules, etc.).
#
# Deliberately NOT enabled:
#  - misc-const-correctness: valuable and already applied, but false-positives on
#    C-API pointer out-params (OpenSSL EVP_PKEY**) and codec bit-twiddling.
#  - performance-unnecessary-value-param: applied everywhere except amf0/amf3,
#    whose template method specializations can't take an automated rewrite.
#  Both were applied by hand; leaving them off keeps the IDE free of noise.
Checks: >
  -*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-emplace,
  modernize-use-bool-literals,
  modernize-use-using,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-default-member-init,
  modernize-loop-convert,
  modernize-redundant-void-arg,
  modernize-make-shared,
  modernize-make-unique,
  readability-else-after-return,
  readability-container-size-empty,
  readability-container-contains,
  readability-string-compare,
  readability-simplify-boolean-expr,
  readability-redundant-member-init,
  readability-redundant-string-init,
  readability-redundant-control-flow,
  readability-redundant-smartptr-get,
  readability-convert-member-functions-to-static,
  readability-isolate-declaration,
  performance-move-const-arg,
  performance-for-range-copy,
  performance-unnecessary-copy-initialization

HeaderFilterRegex: '(basic_rtmp|rtmp|amf|http|flv|crypto|evp_dh|stream_array|config|server|service|mixer|so_manager|authentication|client_session|channel|logging|util|random|io_service|g711|speex|dh|admin|video_|rtmfp/).*\.h$'
WarningsAsErrors: ''
