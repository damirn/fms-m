# Curated clang-tidy config for fms-m. CLion picks this up automatically.
# Enables the "clean/tidy" checks we actually apply and mutes the noisy or
# opinionated ones so the IDE surfaces signal, not style bikeshedding.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-emplace,
  modernize-use-bool-literals,
  modernize-use-using,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-default-member-init,
  modernize-loop-convert,
  modernize-make-shared,
  modernize-make-unique,
  readability-else-after-return,
  readability-container-size-empty,
  readability-redundant-member-init,
  readability-redundant-string-init,
  readability-redundant-control-flow,
  readability-redundant-smartptr-get,
  readability-simplify-boolean-expr,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -performance-avoid-endl,
  -performance-enum-size,
  -modernize-use-trailing-return-type

# Report our own headers, not Boost/OpenSSL/system headers.
HeaderFilterRegex: '(basic_rtmp|rtmp|amf|http|flv|crypto|evp_dh|stream_array|config|server|service|mixer|so_manager|authentication|client_session|channel|logging|util|random|io_service|g711|speex|dh|admin|video_|rtmfp/).*\.h$'
WarningsAsErrors: ''
