# Build and run fms-m on Ubuntu 26.04, with both GCC and Clang toolchains and
# clang-tidy available.
#
# GCC build (default):
#   docker build -f Dockerfile.ubuntu -t fms-ubuntu-gcc .
# Clang build:
#   docker build -f Dockerfile.ubuntu -t fms-ubuntu-clang --build-arg CXX=clang++ .
# AddressSanitizer (either compiler):
#   ... --build-arg CXXFLAGS_EXTRA="-fsanitize=address -fno-omit-frame-pointer -g -O1" \
#       --build-arg LDFLAGS_EXTRA="-fsanitize=address"
FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        clang-tidy \
        cmake \
        pkg-config \
        libboost-all-dev \
        libssl-dev \
        libspeex-dev \
    && rm -rf /var/lib/apt/lists/*

# Clang selects the newest GCC toolchain it finds for its libstdc++; make sure
# that GCC version's libstdc++ linker library (libstdc++.so) is present.
RUN GCCDIR="$(clang++ -v 2>&1 | sed -n 's#.*Selected GCC installation: .*/\([0-9][0-9]*\)$#\1#p')" \
    && apt-get update \
    && apt-get install -y --no-install-recommends "libstdc++-${GCCDIR}-dev" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Compiler and optional extra flags (e.g. a sanitizer). Default: GCC.
ARG CXX=g++
ARG CXXFLAGS_EXTRA=""
ARG LDFLAGS_EXTRA=""

RUN cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_CXX_COMPILER="${CXX}" \
        -DCMAKE_CXX_FLAGS="${CXXFLAGS_EXTRA}" \
        -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS_EXTRA}" \
    && cmake --build build -j"$(nproc)"

RUN mkdir -p /rec /logs

# RTMP/RTMPE (TCP), RTMPT (HTTP tunnel, TCP), RTMFP (UDP)
EXPOSE 1935/tcp 8080/tcp 1935/udp

ENTRYPOINT ["/src/build/fms-m"]
CMD ["--bind-address", "0.0.0.0", \
     "--rtmp-port", "1935", \
     "--rtmpt-port", "8080", \
     "--output-folder", "/rec", \
     "--log-path", "/logs", \
     "--threads", "4"]
